# ============================================
# LLM 配置（评分 / 对话，anthropic 兼容接口）
# 当前默认 DeepSeek；换供应商只改下面三项即可
# ============================================

# --- 身份认证 ---
# DeepSeek: https://platform.deepseek.com
LLM_API_KEY="your-llm-api-key-here"

# --- 端点与模型（模型名不写死在代码里）---
# anthropic 兼容端点（DeepSeek 的 anthropic 适配）
LLM_API_BASE="https://api.deepseek.com/anthropic"
LLM_MODEL="deepseek-v4-flash"

# --- 生成参数 ---
LLM_TEMPERATURE="0.1"
LLM_MAX_TOKENS="512"

# ============================================
# Embedding 配置（向量化，保留智谱：DeepSeek 无 embedding API）
# ============================================

# --- 身份认证 ---
# 智谱: https://open.bigmodel.cn
EMBEDDING_API_KEY="your-embedding-api-key-here"
EMBEDDING_API_BASE="https://open.bigmodel.cn/api/paas/v4"

# Embedding 模型配置
EMBEDDING_MODEL="embedding-3"
EMBEDDING_DIMENSIONS="512"

# ============================================
# GitHub 项目数据管道（RAG 索引构建）
# ============================================

# GitHub PAT (Fine-grained, public repo 只读)
# 在 https://github.com/settings/tokens 获取
GITHUB_TOKEN="your-github-token-here"

# --- 常规筛选规则（OR 门逻辑）---
FRONTIER_THRESHOLD="80"
SIGNAL_THRESHOLD="80"
COMPOSITE_THRESHOLD="60"
MAX_AGE_DAYS="7"

# --- ArXiv 筛选规则（OR 门逻辑）---
ARXIV_FRONTIER_THRESHOLD="70"
ARXIV_UTILITY_THRESHOLD="70"
ARXIV_COMPOSITE_THRESHOLD="65"
ARXIV_MAX_ITEMS_PER_SOURCE="100"
ARXIV_MAX_AFTER_COARSE="20"

# --- 爬取控制 ---
RSS_ITEMS_PER_SOURCE="5"
HTTP_TIMEOUT="15"
LLM_REQUEST_INTERVAL="6"

# --- 软监控 ---
MIN_ITEMS_PER_UPDATE="8"

# ============================================
# Supabase（RAG 向量存储）
# ============================================
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key-here"